{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/maxwellkopitz/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.local/scripts/claude-statusline"
  },
  "enabledPlugins": {
    "vercel@claude-plugins-official": true
  },
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "theme": "dark",
  "editorMode": "vim"
}
